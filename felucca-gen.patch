+/* CHAOS: the logistic map x' = r x (1 - x) in Q16, r = 3.5 .. 4.0 by P1: periodic at the bottom, chaotic at the top */
+static uint32_t gen_logistic(uint32_t x16, uint32_t r100)    /* r100: 350..400 */
