diff --git a/firmware/src/gen_ui.c b/firmware/src/gen_ui.c
index 2350689..bf6f22b 100644
--- a/firmware/src/gen_ui.c
+++ b/firmware/src/gen_ui.c
@@ -248,11 +248,21 @@ static void gen_layer_map(void)
         if (p == 12u && chain_busy()) st = LS_DIM;
         if ((p == 4u || p == 5u) && !g->hist_len) st = LS_DIM;
         n[0] = W_NOTE[p];
+        if (ux.style == ST_RISO) {                     /* RISO: the row's ink: orange rolls, blue state, teal sections, violet song */
+            static const uint8_t ROW_INK[4] = {0, 1, 4, 3};
+            ux_pen = UI_RISO_INK[ROW_INK[p / 4u]]; ux_pen2 = UI_RISO_INK[(ROW_INK[p / 4u] + 1u) % 4u];
+        }
         lcell(LC_X(p % 4u), 4 + (LF_H + 4) * (int32_t)(p / 4u), LF_H, n, 0, 0, GEN_KEY_NAME[p], st | (p & 1u ? LS_ALT : 0u), 0);   /* the FX map's rows */
+        ux_pen = ux_pen2 = 0;
     }
+    if (drum && ux.style == ST_RISO)                   /* RISO: the lanes sit on a yellow block, as a second pass of the drum */
+        cv_rect(4, LM_Y - 3, 232, LM_H + 6, UI_RISO_INK[6]);
     for (p = 0; drum && p < NLANE; p++) {              /* the lane locks (black keys 1..8) */
         int32_t x = 6 + 29 * (int32_t)p;               /* the black keys' row (the FX map's LM_Y): 8 cells of 25 px */
-        uint16_t ink, fill = lc_box(x, LM_Y, 25, LM_H, lc_fill((g->lane_lock >> p) & 1u ? LS_SEL : LS_OFF, &ink));
+        uint16_t ink, fill;
+        if (ux.style == ST_RISO) { ux_pen = UI_RISO_INK[2]; ux_pen2 = UI_RISO_INK[6]; }   /* RISO: green on the yellow block */
+        fill = lc_box(x, LM_Y, 25, LM_H, lc_fill((g->lane_lock >> p) & 1u ? LS_SEL : LS_OFF, &ink));
+        ux_pen = ux_pen2 = 0;
         cv_text_in(x, LM_Y + CAP_IN(S, LM_H), 25, &AF_S, drum_lane_abbr(TSEL, p), ink, fill);
     }
     if (!drum) {                                       /* a pitched track: the key, the role, the locks used */
diff --git a/firmware/src/gfx.c b/firmware/src/gfx.c
index b54a7ec..28e2fb3 100644
--- a/firmware/src/gfx.c
+++ b/firmware/src/gfx.c
@@ -92,6 +92,15 @@ static struct {
  * Selections, accents, keys and gauges keep their fills in every style */
 #define ST_FLAT 0u
 #define ST_LINE 1u
+#define ST_RISO 3u                   /* GEN: a risograph print: every box outlined in an ink with a 1 px misregistered
+                                      * shadow in the next ink, the four knob cards and the layer rows each their own
+                                      * ink (UI_RISO_INK); 3, as stored (ui.c ui_style: 2 was the retired PIXEL) */
+/* the drum set of ST_RISO: orange, blue, green, violet (the four columns), teal, pink, yellow (fills only), black;
+ * dense prints of the inks, so text in them clears 3.5:1 on the RISO palette's paper (tools/gen_ui_palettes.py) */
+#define UI_RISO_INK_N 8u
+static const uint16_t UI_RISO_INK[UI_RISO_INK_N] = {0xAA23, 0x231A, 0x1BA7, 0x79FA, 0x138D, 0xB1AE, 0xF623, 0x18C3};
+static uint16_t ux_pen = 0, ux_pen2 = 0;   /* ST_RISO: the ink a box is outlined in, and its shadow's (0: the text colour) */
+static uint32_t ux_col_ink(uint32_t c) { return UI_RISO_INK[c & 3u]; }
 #define T_RULE ux.dim            /* LINE: the dividers (DIM: visible on NIGHT, GREY, MONO and PAPER, quieter than labels) */
 #define T_BG ux.bg               /* background */
 #define T_SURF ux.surf           /* dialogs, menu rows, mixer strips */
@@ -152,7 +161,7 @@ static void palette_set(uint32_t i)
     const ui_pal_t *p = cust ? &ux_cust : &UI_PALETTES[i % NPALETTES];
     i %= NPALETTES;
     ux.mono = !cust && i == UI_GREY_INDEX;
-    ux.bg = p->bg; ux.surf = ux.style ? p->bg : p->surf; ux.text = p->text; ux.theme = p->theme; ux.accent = p->accent;
+    ux.bg = p->bg; ux.surf = ux.style == ST_LINE ? p->bg : p->surf;   /* (LINE: no surfaces; RISO keeps them) */ ux.text = p->text; ux.theme = p->theme; ux.accent = p->accent;
