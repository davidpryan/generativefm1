From fd5526d1ff672dfeb58d9f77c299bd626fd2f990 Mon Sep 17 00:00:00 2001
From: GEN <gen@localhost>
Date: Thu, 15 Oct 2026 17:46:03 -0700
Subject: [PATCH 2/9] GEN: GitHub Actions build with a Pages installer

Fetches the JieLi toolchain and AC79 SDK on the runner, runs the GEN and UI host
tests, builds felucca-1.6-gen.fwsc, uploads it with an installer folder as an
artifact, and publishes the web installer to GitHub Pages from the default branch.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UKiQQaFAeD8B44b8duY1gJ
---
 .github/workflows/build.yml | 112 ++++++++++++++++++++++++++++++++++++
 1 file changed, 112 insertions(+)
 create mode 100644 .github/workflows/build.yml

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..48ee915
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,112 @@
+# Builds the firmware on every push, and publishes a web installer to GitHub Pages.
+# The JieLi toolchain and SDK are fetched here (Linux x86-64), so nothing is needed on your own machine.
+#
+# After a green run:
+#   - Artifacts (bottom of the run page): felucca-gen-firmware.zip = the .fwsc + an installer folder
+#   - Pages (Settings > Pages must be set to "GitHub Actions" once): the installer at
+#     https://<you>.github.io/<repo>/  : connect the FM-1 by USB, open it in Chrome or Edge, press Install.
+name: build
+
+on:
+  push:
+    branches: ["**"]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+env:
+  GEN_VERSION: "1.6-gen"          # the package's version string (X.Y-suffix: build.py --release)
+
+jobs:
+  firmware:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: recursive   # firmware/engines (Felucca-Engines)
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Python packages
+        run: pip install Pillow fonttools mido
+
+      - name: JieLi toolchain (cached)
+        id: tc
+        uses: actions/cache@v4
+        with:
+          path: ~/.jieli
+          key: jieli-toolchain-v1
+
+      - name: JieLi toolchain (download)
+        if: steps.tc.outputs.cache-hit != 'true'
+        run: tools/get_toolchain.sh
+
+      - name: JieLi AC79 SDK (cached)
+        id: sdk
+        uses: actions/cache@v4
+        with:
+          path: ~/fw-AC79_AIoT_SDK
+          key: ac79-sdk-V1.2.1-2023-12-13
+
+      - name: JieLi AC79 SDK (clone)
+        if: steps.sdk.outputs.cache-hit != 'true'
+        run: |
+          for i in 1 2 3; do
+            git clone --depth 1 --branch AC79NN_SDK_V1.2.1_2023-12-13 \
+              https://gitee.com/Jieli-Tech/fw-AC79_AIoT_SDK.git ~/fw-AC79_AIoT_SDK && break
+            echo "gitee clone failed, retry $i"; rm -rf ~/fw-AC79_AIoT_SDK; sleep 20
+          done
+          test -f ~/fw-AC79_AIoT_SDK/cpu/wl82/tools/uboot.boot
+
+      - name: Host tests (GEN + the UI suite)
+        run: |
+          mkdir -p build/gen build/host build/gen_demo
+          python3 tools/gen_tables.py build/gen/felucca_tables.h
+          python3 tools/gen_fm6_patches.py build/gen/felucca_fm6.h
+          python3 tools/gen_samples.py build/gen/felucca_samples.h
+          python3 tools/gen_ui_palettes.py build/gen/ui_palettes.h
+          python3 tools/gen_aa_font.py build/gen/ui_fonts.h --preset inter-tight
+          python3 tools/gen_aa_icons.py build/gen/ui_icons.h
+          python3 tools/gen_aa_keycaps.py build/gen/ui_keycaps.h
+          cc -O1 -w -Ibuild/gen -Ifirmware/src -o build/host/gen_test tests/gen_test.c -lm
+          build/host/gen_test build/gen_demo
+          cc -O1 -w -Ibuild/gen -Ifirmware/src -o build/host/ui_test tests/ui_test.c -lm
+          build/host/ui_test
+
+      - name: Build the firmware
+        run: ./build.sh --release "$GEN_VERSION"
+
+      - name: Web installer
+        run: |
+          python3 web/make_site.py "build/felucca-$GEN_VERSION.fwsc" "$GEN_VERSION" build/site
+          mkdir -p build/out
+          cp "build/felucca-$GEN_VERSION.fwsc" build/out/
+          cp -r build/site build/out/installer
+          cp -r "build/release-$GEN_VERSION" build/out/release
+          cp build/gen_demo/*.mid build/out/ 2>/dev/null || true
+          cp GEN.md build/out/
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: felucca-gen-firmware
+          path: build/out
+
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: build/site
+
+  pages:
+    needs: firmware
+    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deploy.outputs.page_url }}
+    steps:
+      - id: deploy
+        uses: actions/deploy-pages@v4
-- 
